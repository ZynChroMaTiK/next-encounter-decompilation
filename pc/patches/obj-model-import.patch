+/*
+ * Mapping imported from the one object the main mip model was made of.
+ *
+ * The opened and unwrapped objects are that object again (LoadAny3DFormat_t
+ * with LT_OPENED and LT_UNWRAPPED), so their polygons and corners come in the
+ * same order as the model's mip-0 polygons, and each corner of the unwrapped
+ * object holds that corner's texture coordinates (RemapVertices keys a
+ * vertex on its texture vertex too). So every polygon corner takes the
+ * coordinates of the same corner, and a vertex that carries several in one
+ * surface - a UV seam - gets a texture vertex for each. CalculateUnwrappedMapping
+ * matched texture vertices by position instead, one per vertex a surface: on
+ * a model with one material, the polygons along every seam were mapped with
+ * the other side's coordinates.
+ */
+static void CalculateImportedMapping( CModelData &md, CObject3D &o3dOpened, CObject3D &o3dUnwrapped) // throw char *
+{
+  ModelMipInfo *pMMI = &md.md_MipInfos[0];
+  INDEX ctPolygons = pMMI->mmpi_Polygons.Count();
+  INDEX ctCorners = 0;
+  for( INDEX iPol=0; iPol<ctPolygons; iPol++) {
+    ctCorners += pMMI->mmpi_Polygons[iPol].mp_PolygonVertices.Count();
+  }
+
+  // the texture vertices to make: candidates chained per transformed vertex
+  CStaticStackArray<ModelTextureVertex> amtvNew;
+  CStaticStackArray<INDEX> aiNewSurface, aiNext;
+  CStaticArray<INDEX> aiFirst;
+  aiFirst.New( md.md_VerticesCt);
+  for( INDEX iVtx=0; iVtx<md.md_VerticesCt; iVtx++) {
+    aiFirst[iVtx] = -1;
+  }
+  CStaticArray<INDEX> aiCornerTexture;
+  aiCornerTexture.New( ctCorners);
+
+  o3dOpened.ob_aoscSectors.Lock();
+  o3dUnwrapped.ob_aoscSectors.Lock();
+  CObjectSector &oscOpened = o3dOpened.ob_aoscSectors[0];
+  CObjectSector &oscUnwrapped = o3dUnwrapped.ob_aoscSectors[0];
+  oscOpened.LockAll();
+  oscUnwrapped.LockAll();
+  INDEX iCorner = 0;
+  for( INDEX iPol=0; iPol<ctPolygons; iPol++)
+  {
+    ModelPolygon &mp = pMMI->mmpi_Polygons[iPol];
+    CObjectPolygon &opo = oscOpened.osc_aopoPolygons[iPol];
+    INDEX ctPolyCorners = mp.mp_PolygonVertices.Count();
+    if( opo.opo_PolygonEdges.Count() != ctPolyCorners) {
+      oscOpened.UnlockAll();
+      oscUnwrapped.UnlockAll();
+      o3dOpened.ob_aoscSectors.Unlock();
+      o3dUnwrapped.ob_aoscSectors.Unlock();
+      ThrowF_t("ERROR: Polygon %d has %d vertices in the model and %d in the object that defines its mapping!",
+        iPol, ctPolyCorners, opo.opo_PolygonEdges.Count());
+    }
+    opo.opo_PolygonEdges.Lock();
+    for( INDEX iPolyCorner=0; iPolyCorner<ctPolyCorners; iPolyCorner++)
+    {
+      // this corner in the opened object, and its coordinates in the unwrapped one
+      CObjectPolygonEdge &ope = opo.opo_PolygonEdges[iPolyCorner];
+      CObjectVertex *povOpened = ope.ope_Backward ? ope.ope_Edge->oed_Vertex1 : ope.ope_Edge->oed_Vertex0;
+      INDEX iOpened = oscOpened.osc_aovxVertices.Index( povOpened);
+      FLOAT3D vUVW = DOUBLEtoFLOAT( oscUnwrapped.osc_aovxVertices[ iOpened]);
+      vUVW(2) = -vUVW(2);
+      MEX2D mexUV;
+      mexUV(1) = MEX_METERS( vUVW(1));
+      mexUV(2) = MEX_METERS( vUVW(2));
+
+      // the texture vertex with this vertex, surface and coordinates, or a new one
+      ModelPolygonVertex &mpv = mp.mp_PolygonVertices[iPolyCorner];
+      INDEX iTransformed = md.md_TransformedVertices.Index( mpv.mpv_ptvTransformedVertex);
+      INDEX iTexture = aiFirst[iTransformed];
+      while( iTexture != -1 && !(aiNewSurface[iTexture] == mp.mp_Surface
+        && amtvNew[iTexture].mtv_UV(1) == mexUV(1) && amtvNew[iTexture].mtv_UV(2) == mexUV(2)))
+      {
+        iTexture = aiNext[iTexture];
+      }
+      if( iTexture == -1)
+      {
+        ModelTextureVertex &mtv = amtvNew.Push();
+        mtv = *mpv.mpv_ptvTextureVertex;
+        mtv.mtv_UVW = vUVW;
+        mtv.mtv_UV = mexUV;
+        mtv.mtv_iTransformedVertex = iTransformed;
+        aiNewSurface.Push() = mp.mp_Surface;
+        aiNext.Push() = aiFirst[iTransformed];
+        iTexture = amtvNew.Count()-1;
+        aiFirst[iTransformed] = iTexture;
+      }
+      aiCornerTexture[iCorner++] = iTexture;
+    }
+    opo.opo_PolygonEdges.Unlock();
+  }
+  oscOpened.UnlockAll();
+  oscUnwrapped.UnlockAll();
+  o3dOpened.ob_aoscSectors.Unlock();
+  o3dUnwrapped.ob_aoscSectors.Unlock();
+
+  // replace the texture vertices and point every corner at its own
+  pMMI->mmpi_TextureVertices.Clear();
+  pMMI->mmpi_TextureVertices.New( amtvNew.Count());
+  for( INDEX iTexture=0; iTexture<amtvNew.Count(); iTexture++) {
+    pMMI->mmpi_TextureVertices[iTexture] = amtvNew[iTexture];
+  }
+  iCorner = 0;
+  for( INDEX iPol=0; iPol<ctPolygons; iPol++)
+  {
+    ModelPolygon &mp = pMMI->mmpi_Polygons[iPol];
+    for( INDEX iPolyCorner=0; iPolyCorner<mp.mp_PolygonVertices.Count(); iPolyCorner++) {
+      mp.mp_PolygonVertices[iPolyCorner].mpv_ptvTextureVertex = &pMMI->mmpi_TextureVertices[ aiCornerTexture[iCorner++]];
+    }
+  }
+  // each surface's polygons and texture vertices again
+  md.LinkDataForSurfaces(TRUE);
+
+  // reset surface position, rotation and zoom, as CalculateUnwrappedMapping does
+  for( INDEX iSurface=0; iSurface<pMMI->mmpi_MappingSurfaces.Count(); iSurface++)
+  {
+    MappingSurface &ms = pMMI->mmpi_MappingSurfaces[iSurface];
+    ms.ms_HPB = FLOAT3D( 0.0f, 0.0f, 0.0f);
+    ms.ms_Zoom = 1.0f;
+    ms.ms_vSurface2DOffset = FLOAT3D( 0.0f, 0.0f, 0.0f);
+  }
+}
