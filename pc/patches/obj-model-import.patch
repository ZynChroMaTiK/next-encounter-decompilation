+#if !USE_E3D
+/*
+ * Wavefront OBJ into the conversion arrays, the way FillConversionArrays_t
+ * takes an Exploration 3D object: vertices through mTransform and then x and z
+ * negated, faces flipped when mTransform mirrors, one material per usemtl
+ * name in order of first use. Faces with more than three corners are fans.
+ */
+static void FillConversionArraysOBJ_t(const CTFileName &fnmFileName, const FLOATmatrix3D &mTransform)
+{
+  const FLOATmatrix3D &m = mTransform;
+  FLOAT fDet =
+    m(1,1)*(m(2,2)*m(3,3)-m(2,3)*m(3,2))+
+    m(1,2)*(m(2,3)*m(3,1)-m(2,1)*m(3,3))+
+    m(1,3)*(m(2,1)*m(3,2)-m(2,2)*m(3,1));
+  BOOL bFlipped = fDet<0;
+
+  CStaticStackArray<FLOAT3D> avPos;
+  CStaticStackArray<FLOAT2D> avUV;
+  CStaticStackArray<ConversionTriangle> actTris;
+  CTString astrMaterials[256];      // usemtl names, in order of first use
+  INDEX ctMaterials = 0;
+  INDEX iMaterial = -1;
+
+  CTFileStream strm;
+  strm.Open_t(fnmFileName);
+  char achLine[1024];
+  while (!strm.AtEOF()) {
+    strm.GetLine_t(achLine, sizeof(achLine));
+    char *pch = achLine;
+    while (*pch==' ' || *pch=='\t') { pch++; }
+    if (pch[0]=='v' && (pch[1]==' ' || pch[1]=='\t')) {
+      FLOAT3D v(0,0,0);
+      sscanf(pch+2, "%f %f %f", &v(1), &v(2), &v(3));
+      avPos.Push() = v;
+    } else if (pch[0]=='v' && pch[1]=='t' && (pch[2]==' ' || pch[2]=='\t')) {
+      FLOAT2D t(0,0);
+      sscanf(pch+3, "%f %f", &t(1), &t(2));
+      avUV.Push() = t;
+    } else if (strncmp(pch, "usemtl", 6)==0) {
+      char achName[256] = "Default";
+      sscanf(pch+6, "%255s", achName);
+      iMaterial = -1;
+      for (INDEX i=0; i<ctMaterials; i++) {
+        if (astrMaterials[i]==CTString(achName)) { iMaterial = i; }
+      }
+      if (iMaterial<0) {
+        if (ctMaterials>=256) { ThrowF_t("%s: more than 256 materials", (const char *)fnmFileName); }
+        astrMaterials[ctMaterials] = CTString(achName);
+        iMaterial = ctMaterials++;
+      }
+    } else if (pch[0]=='f' && (pch[1]==' ' || pch[1]=='\t')) {
+      INDEX aiV[64], aiT[64], ct = 0;
+      char *pchTok = pch+2;
+      while (ct<64) {
+        while (*pchTok==' ' || *pchTok=='\t') { pchTok++; }
+        if (*pchTok==0 || *pchTok=='\r' || *pchTok=='\n') { break; }
+        INDEX iV = 0, iT = 0;
+        sscanf(pchTok, "%d", &iV);
+        char *pchSlash = pchTok;
+        while (*pchSlash && *pchSlash!='/' && *pchSlash!=' ' && *pchSlash!='\t') { pchSlash++; }
+        if (*pchSlash=='/' && pchSlash[1]!='/') { sscanf(pchSlash+1, "%d", &iT); }
+        aiV[ct] = iV<0 ? avPos.Count()+iV : iV-1;
+        aiT[ct] = iT<0 ? avUV.Count()+iT : iT-1;
+        ct++;
+        while (*pchTok && *pchTok!=' ' && *pchTok!='\t') { pchTok++; }
+      }
+      if (iMaterial<0) {
+        astrMaterials[ctMaterials] = CTString("Default");
+        iMaterial = ctMaterials++;
+      }
+      for (INDEX i=1; i+1<ct; i++) {
+        ConversionTriangle &ctri = actTris.Push();
+        INDEX aiCorner[3] = {0, i, i+1};
+        for (INDEX k=0; k<3; k++) {
+          INDEX c = aiCorner[bFlipped ? 2-k : k];
+          ctri.ct_iVtx[k] = aiV[c];
+          ctri.ct_iTVtx[k] = aiT[c]<0 ? 0 : aiT[c];
+        }
+        ctri.ct_iMaterial = iMaterial;
+      }
+    }
+  }
+
+  avVertices.New(avPos.Count());
+  for (INDEX iVtx=0; iVtx<avPos.Count(); iVtx++) {
+    avVertices[iVtx] = avPos[iVtx]*mTransform;
+    avVertices[iVtx](1) = -avVertices[iVtx](1);
+    avVertices[iVtx](3) = -avVertices[iVtx](3);
+  }
+  avTextureVertices.New(avUV.Count()>0 ? avUV.Count() : 1);
+  if (avUV.Count()==0) { avTextureVertices[0] = FLOAT2D(0,0); }
+  // Exploration 3D gave v negated: rebuilt from the designers' MonkeyMan.obj,
+  // this matches their MonkeyMan.mdl corner for corner only with -v
+  for (INDEX iTVtx=0; iTVtx<avUV.Count(); iTVtx++) {
+    avTextureVertices[iTVtx] = FLOAT2D(avUV[iTVtx](1), -avUV[iTVtx](2));
+  }
+  actTriangles.New(actTris.Count());
+  for (INDEX iMat=0; iMat<ctMaterials; iMat++) {
+    ConversionMaterial *pcm = new ConversionMaterial;
+    pcm->cm_ulTag = iMat;
+    pcm->cm_strName = astrMaterials[iMat];
+    pcm->cm_colColor = C_GRAY;
+    acmMaterials.Add(pcm);
+  }
+  acmMaterials.Lock();
+  for (INDEX iTri=0; iTri<actTris.Count(); iTri++) {
+    const ConversionTriangle &ctri = actTris[iTri];
+    for (INDEX k=0; k<3; k++) {
+      if (ctri.ct_iVtx[k]<0 || ctri.ct_iVtx[k]>=avPos.Count()) {
+        acmMaterials.Unlock();
+        ThrowF_t("%s: a face names vertex %d of %d", (const char *)fnmFileName, ctri.ct_iVtx[k]+1, avPos.Count());
+      }
+    }
+    actTriangles[iTri] = ctri;
+    INDEX *piTri = new INDEX(1);
+    *piTri = iTri;
+    acmMaterials[ctri.ct_iMaterial].ms_Polygons.Add(piTri);
+  }
+  acmMaterials.Unlock();
+}
